# ---- Local development: no .env needed. ----

# ---- Production (Vercel > Project Settings > Environment Variables) ----
# Long random string. Signs nothing public, but encrypts 2FA secrets. Do not change it later.
JWT_SECRET=
# Hosted database (Turso). Without these the app would use a local file, which Vercel cannot keep.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=
# Skip demo accounts and create your first admin instead
SEED=0
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
